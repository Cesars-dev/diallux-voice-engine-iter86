[Unit]
Description=Retell-Groq LLM Middleware
After=network.target

[Service]
Type=simple
User=julio
WorkingDirectory=/home/julio/projects/VoiceAI/groq-server
EnvironmentFile=/home/julio/projects/VoiceAI/groq-server/.env
ExecStart=/home/julio/.local/bin/uvicorn server:app --host 0.0.0.0 --port 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
