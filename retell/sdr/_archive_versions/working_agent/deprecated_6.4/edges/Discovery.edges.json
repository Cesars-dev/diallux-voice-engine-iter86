[
  {
    "description": "When discovery_completed, industry, pain_points, interest_signal, pattern_matched are all filled, transition to Closer.",
    "speak_during_transition": false,
    "destination_state_name": "Closer",
    "parameters": {
      "type": "object",
      "properties": {
        "industry": {
          "type": "string",
          "description": "Business industry"
        },
        "pain_points": {
          "type": "string",
          "description": "Comma-separated challenges discovered so far"
        },
        "interest_signal": {
          "type": "boolean",
          "description": "True when the prospect showed buying intent"
        },
        "pattern_matched": {
          "type": "boolean",
          "description": "True once they connected their pain to the phone gap"
        },
        "pain_urgency": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Urgency level"
        },
        "call_volume": {
          "type": "string",
          "description": "Approximate call volume"
        },
        "company_name": {
          "type": "string",
          "description": "Company name if known"
        },
        "first_name": {
          "type": "string",
          "description": "Prospect's first name if known"
        },
        "discovery_completed": {
          "type": "boolean",
          "description": "true ONLY after: When the industry is known, problems are collected, they've connected their pain to the phone gap, and they've shown intent."
        }
      },
      "required": [
        "discovery_completed",
        "industry",
        "pain_points",
        "interest_signal",
        "pattern_matched"
      ]
    }
  }
]
