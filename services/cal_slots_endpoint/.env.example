RETELL_API_KEY=
CAL_COM_API_KEY=
EVENT_TYPE_ID=6522694
TIMEZONE=Europe/London
CAL_API_VERSION=2024-09-04
CAL_COM_BASE=https://api.cal.com/v2
SLOT_DURATION_MIN=60
LOOKAHEAD_DAYS=7
MAX_SLOTS=20
RATE_LIMIT_PER_MIN=120
# Multi-account: one entry per calendar. The LLM passes the account_id (fixed
# per agent via the tool schema default). duration defaults to SLOT_DURATION_MIN.
CAL_ACCOUNTS={
  "diallux":       {"cal_api_key":"YOUR_KEY","event_type_id":6522694,"timezone":"Europe/London","duration":60},
  "diallux_live":  {"cal_api_key":"YOUR_LIVE_KEY","event_type_id":3801235,"timezone":"America/Mexico_City","duration":45}
}
REQUEST_TIMEOUT=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
