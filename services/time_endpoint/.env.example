# Retell API Key for signature verification (same webhook key as cal_slots_endpoint)
RETELL_API_KEY=your_retell_webhook_api_key_here

# Service configuration
SERVICE_PORT=8002
SERVICE_NAME=time-service

# Timezone defaults
DEFAULT_TIMEZONE=Europe/London
DEFAULT_OUTPUT_FORMAT=today,now,timestamp,iso_format

# Rate limiting (per IP per minute)
RATE_LIMIT_PER_MIN=120
