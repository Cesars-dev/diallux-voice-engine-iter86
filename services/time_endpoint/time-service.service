[Unit]
Description=Time Service - Agent Agnostic Time Parsing (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/julio/projects/Retell_AI_MCP_connection/time_endpoint
EnvironmentFile=/home/julio/projects/Retell_AI_MCP_connection/time_endpoint/.env
ExecStart=/home/julio/projects/Retell_AI_MCP_connection/time_endpoint/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002 --timeout-keep-alive 5 --limit-concurrency 32 --limit-max-requests 5000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
