[Unit]
Description=Lead Validator Service (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/julio/projects/Retell_AI_MCP_connection/validator_endpoint
EnvironmentFile=/home/julio/projects/Retell_AI_MCP_connection/validator_endpoint/.env
ExecStart=/home/julio/projects/Retell_AI_MCP_connection/validator_endpoint/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8003 --timeout-keep-alive 5 --limit-concurrency 32 --limit-max-requests 5000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
